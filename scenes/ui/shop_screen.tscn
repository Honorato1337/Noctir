[gd_scene format=3]

[ext_resource type="Theme" path="res://ui_theme.tres" id="1"]
[ext_resource type="Script" path="res://scripts/pixel_backdrop.gd" id="2"]


[ext_resource type="Texture2D" path="res://assets/icons/medkit.svg" id="medkit"]

[ext_resource type="Texture2D" path="res://assets/icons/bomb.svg" id="bomb"]

[ext_resource type="Texture2D" path="res://assets/icons/shield.svg" id="shield"]

[ext_resource type="Texture2D" path="res://assets/icons/overdrive.svg" id="overdrive"]

[ext_resource type="Script" path="res://scripts/shop_details.gd" id="details"]

[node name="ShopScreen" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("1")
texture_filter = 1
script = ExtResource("details")

[node name="Backdrop" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
color = Color(0.008, 0.016, 0.03, 1)
script = ExtResource("2")

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2


[node name="Card" type="PanelContainer" parent="Center"]
layout_mode = 2
custom_minimum_size = Vector2(1024, 0)

[node name="Box" type="VBoxContainer" parent="Center/Card"]
layout_mode = 2
theme_override_constants/separation = 14
theme_override_constants/separation = 10

[node name="Header" type="HBoxContainer" parent="Center/Card/Box"]
layout_mode = 2
theme_override_constants/separation = 14


[node name="Title" type="Label" parent="Center/Card/Box/Header"]
layout_mode = 2
mouse_filter = 2
theme_override_font_sizes/font_size = 32
text = "LOJA ORBITAL"
theme_override_colors/font_color = Color(0.44, 0.9, 0.82, 1)
size_flags_horizontal = 3

[node name="ShopTimer" type="Label" parent="Center/Card/Box/Header"]
